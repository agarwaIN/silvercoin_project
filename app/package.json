{
  "name": "silvercoin-app",
  "version": "1.0.0",
  "main": "node_modules/expo/AppEntry.js",
  "scripts": {
    "dev": "expo start",
    "start": "expo start",
    "start:clear": "expo start --clear",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "build:apk": "npx --yes eas-cli@latest build -p android --profile preview --non-interactive",
    "build:apk:prod": "npx --yes eas-cli@latest build -p android --profile production --non-interactive",
    "build:list": "npx --yes eas-cli@latest build:list",
    "postinstall": "node -e \"try { require('fs').chmodSync('node_modules/react-native/sdks/hermesc/linux64-bin/hermesc', 0o755); } catch (e) {}\""
  },
  "dependencies": {
    "@expo-google-fonts/poppins": "^0.2.3",
    "@expo/vector-icons": "^15.0.3",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-navigation/native": "^6.1.17",
    "@react-navigation/stack": "^6.3.29",
    "axios": "^1.13.5",
    "babel-preset-expo": "~57.0.0",
    "expo": "^57.0.10",
    "expo-camera": "~57.0.3",
    "expo-constants": "~57.0.9",
    "expo-document-picker": "~57.0.1",
    "expo-file-system": "~57.0.7",
    "expo-font": "~57.0.1",
    "expo-image-picker": "~57.0.7",
    "expo-location": "~57.0.7",
    "expo-media-library": "~57.0.5",
    "expo-secure-store": "~57.0.1",
    "expo-sharing": "^57.0.18",
    "expo-splash-screen": "~57.0.5",
    "expo-status-bar": "~57.0.1",
    "expo-video": "~57.0.2",
    "react": "19.2.3",
    "react-native": "0.86.2",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-maps": "1.27.2",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-signature-canvas": "^4.7.2",
    "react-native-webview": "13.16.1"
  },
  "devDependencies": {
    "@babel/core": "^7.24.0"
  },
  "overrides": {
    "postcss": "^8.5.10",
    "uuid": "^11.1.0"
  },
  "private": true
}
